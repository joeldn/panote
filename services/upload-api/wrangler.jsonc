{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys REQUIRE an environment: `wrangler deploy --env dev|production`.
  // Wrangler does NOT inherit vars/bindings into named environments, so every
  // binding is repeated under each env block. A bare `wrangler deploy` has none.
  "name": "panote-upload-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "dev": {
      "name": "panote-upload-api-dev",
      // routes need panote.dev to be an Active zone before this env can deploy
      // workers_dev gives a second URL for smoke tests
      "workers_dev": true,
      "routes": [{ "pattern": "panote.dev/api/upload-url", "zone_name": "panote.dev" }],
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put R2_ACCESS_KEY_ID --env dev ; wrangler secret put R2_SECRET_ACCESS_KEY --env dev
      "vars": {
        "OAUTH_ISSUER": "https://panote-dev.au.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.dev",
        "R2_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        "R2_BUCKET": "pano-content-dev",
      },
    },
    "production": {
      // production is unprovisioned, see docs/deploy.md
      "name": "panote-upload-api",
      "workers_dev": false,
      "routes": [{ "pattern": "panote.io/api/upload-url", "zone_name": "panote.io" }],
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put R2_ACCESS_KEY_ID --env production ; wrangler secret put R2_SECRET_ACCESS_KEY --env production
      "vars": {
        // OAUTH_ISSUER is a placeholder until the Auth0 tenant exists; replace it
        // only with the real tenant URL, never another fake name.
        "OAUTH_ISSUER": "https://YOUR_PROD_TENANT.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.io",
        "R2_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        "R2_BUCKET": "pano-content",
      },
    },
  },
}
