{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys REQUIRE an environment: `wrangler deploy --env dev|production`.
  // Wrangler does NOT inherit vars/bindings into named environments, so every
  // binding is repeated under each env block. A bare `wrangler deploy` has none.
  "name": "panote-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "dev": {
      "name": "panote-admin-api-dev",
      // routes need panote.dev to be an Active zone before this env can deploy
      // workers_dev gives a second URL for smoke tests
      "workers_dev": true,
      "routes": [{ "pattern": "panote.dev/api/admin/*", "zone_name": "panote.dev" }],
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put CF_ANALYTICS_TOKEN --env dev (Account Analytics: Read).
      // R2 goes through the native binding, not the S3 API.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content-dev" }],
      "vars": {
        "OAUTH_ISSUER": "https://panote-dev.au.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.dev",
        "CF_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        // public-api's EVENTS dataset for the same env
        "AE_DATASET": "panote_events_dev",
      },
    },
    "production": {
      // production is unprovisioned, see docs/deploy.md
      "name": "panote-admin-api",
      "workers_dev": false,
      "routes": [{ "pattern": "panote.io/api/admin/*", "zone_name": "panote.io" }],
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put CF_ANALYTICS_TOKEN --env production (Account Analytics: Read).
      // R2 goes through the native binding, not the S3 API.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content" }],
      "vars": {
        // OAUTH_ISSUER is a placeholder until the Auth0 tenant exists; replace it
        // only with the real tenant URL, never another fake name.
        "OAUTH_ISSUER": "https://YOUR_PROD_TENANT.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.io",
        "CF_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        "AE_DATASET": "panote_events",
      },
    },
  },
}
