{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys REQUIRE an environment: `wrangler deploy --env dev|production`.
  // Wrangler does NOT inherit vars/bindings into named environments, so every
  // binding is repeated under each env block. A bare `wrangler deploy` has none.
  "name": "panote-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "dev": {
      "name": "panote-admin-api-dev",
      // routes need panote.dev to be an Active zone before this env can deploy
      // workers.dev and Preview URLs are off: they would bypass the Access gate on
      // panote.dev (docs/deploy.md, Cloudflare Access).
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "panote.dev/api/admin/*", "zone_name": "panote.dev" }],
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put CF_ANALYTICS_TOKEN --env dev (Account Analytics: Read)
      // and CF_PURGE_TOKEN (Zone > Cache Purge, optional, B6), and OPERATOR_TOKEN (optional:
      // enables the operator takedown route, docs/deploy.md "Takedown").
      // R2 goes through the native binding, not the S3 API.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content-dev" }],
      // Serializes publish/slug/visibility changes per tour (one instance per tourId).
      "durable_objects": {
        "bindings": [
          { "name": "PUBLISHER", "class_name": "TourPublisher" },
          // public-api's per-tour view/like counters; account delete clears them.
          { "name": "STATS", "class_name": "TourStats", "script_name": "panote-public-api-dev" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TourPublisher"] }],
      // namespace_id is ours to choose (any integer, unique in the account; nothing to
      // create), dev 13xx and production 23xx. `period` (10 or 60) must match
      // WRITE_RATE_PERIOD_SECONDS in src/index.ts, which is the 429's Retry-After.
      // Writes (POST/PUT/PATCH/DELETE) per owner (Auth0 sub) per minute. 120 lets one
      // Save of a full tour through in a burst: MAX_TOUR_SCENES (100) configs + tour + publish.
      "ratelimits": [
        {
          "name": "WRITE_LIMITER",
          "namespace_id": "1301",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "vars": {
        "OAUTH_ISSUER": "https://panote-dev.au.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.dev",
        "CF_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        // public-api's EVENTS dataset for the same env
        "AE_DATASET": "panote_events_dev",
        // Days an old slug keeps redirecting after a rename (plan 3.2, Q6).
        "SLUG_ALIAS_DAYS": "30",
        // CDN purge target (B6): the panote.dev zone id (not secret).
        "CDN_ZONE_ID": "2196d8dead0322ad69307711fc72b5d3",
        "CDN_HOST": "cdn.panote.dev",
      },
      // Daily sweep that releases expired slug aliases.
      "triggers": { "crons": ["17 3 * * *"] },
    },
    "production": {
      // production is unprovisioned, see docs/deploy.md
      "name": "panote-admin-api",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "panote.io/api/admin/*", "zone_name": "panote.io" }],
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put CF_ANALYTICS_TOKEN --env production (Account Analytics: Read)
      // and CF_PURGE_TOKEN (Zone > Cache Purge, optional, B6), and OPERATOR_TOKEN (optional:
      // enables the operator takedown route, docs/deploy.md "Takedown").
      // R2 goes through the native binding, not the S3 API.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content" }],
      // Serializes publish/slug/visibility changes per tour (one instance per tourId).
      "durable_objects": {
        "bindings": [
          { "name": "PUBLISHER", "class_name": "TourPublisher" },
          // public-api's per-tour view/like counters; account delete clears them.
          { "name": "STATS", "class_name": "TourStats", "script_name": "panote-public-api" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TourPublisher"] }],
      // Writes (POST/PUT/PATCH/DELETE) per owner (Auth0 sub) per minute. 120 lets one
      // Save of a full tour through in a burst: MAX_TOUR_SCENES (100) configs + tour + publish.
      "ratelimits": [
        {
          "name": "WRITE_LIMITER",
          "namespace_id": "2301",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "vars": {
        // OAUTH_ISSUER is a placeholder until the Auth0 tenant exists; replace it
        // only with the real tenant URL, never another fake name.
        "OAUTH_ISSUER": "https://YOUR_PROD_TENANT.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.io",
        "CF_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        "AE_DATASET": "panote_events",
        // Days an old slug keeps redirecting after a rename (plan 3.2, Q6).
        "SLUG_ALIAS_DAYS": "30",
        // CDN purge target (B6). Placeholder zone id: the purge no-ops until it's real.
        "CDN_ZONE_ID": "YOUR_PANOTE_IO_ZONE_ID",
        "CDN_HOST": "cdn.panote.io",
      },
      // Daily sweep that releases expired slug aliases.
      "triggers": { "crons": ["17 3 * * *"] },
    },
  },
}
