{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys REQUIRE an environment: `wrangler deploy --env dev|production`.
  // Wrangler does NOT inherit vars/bindings into named environments, so every
  // binding is repeated under each env block. A bare `wrangler deploy` has none.
  "name": "panote-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "dev": {
      "name": "panote-admin-api-dev",
      // routes need panote.dev to be an Active zone before this env can deploy
      // workers_dev gives a second URL for smoke tests
      "workers_dev": true,
      "routes": [{ "pattern": "panote.dev/api/admin/*", "zone_name": "panote.dev" }],
      "observability": { "enabled": true },
      // secrets (per env): CF_PURGE_TOKEN (Zone > Cache Purge), for the best-effort CDN purge.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content-dev" }],
      // Serializes publish/slug/visibility changes per tour (one instance per tourId).
      "durable_objects": {
        "bindings": [{ "name": "PUBLISHER", "class_name": "TourPublisher" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TourPublisher"] }],
      "vars": {
        "OAUTH_ISSUER": "https://panote-dev.au.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.dev",
        // Days an old slug keeps redirecting after a rename (plan 3.2, Q6).
        "SLUG_ALIAS_DAYS": "30",
        // CDN purge target (B6): the panote.dev zone id (not secret).
        "CDN_ZONE_ID": "2196d8dead0322ad69307711fc72b5d3",
        "CDN_HOST": "cdn.panote.dev",
      },
      // Daily sweep that releases expired slug aliases.
      "triggers": { "crons": ["17 3 * * *"] },
    },
    "production": {
      // production is unprovisioned, see docs/deploy.md
      "name": "panote-admin-api",
      "workers_dev": false,
      "routes": [{ "pattern": "panote.io/api/admin/*", "zone_name": "panote.io" }],
      "observability": { "enabled": true },
      // secrets (per env): CF_PURGE_TOKEN (Zone > Cache Purge), for the best-effort CDN purge.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content" }],
      // Serializes publish/slug/visibility changes per tour (one instance per tourId).
      "durable_objects": {
        "bindings": [{ "name": "PUBLISHER", "class_name": "TourPublisher" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TourPublisher"] }],
      "vars": {
        // OAUTH_ISSUER is a placeholder until the Auth0 tenant exists; replace it
        // only with the real tenant URL, never another fake name.
        "OAUTH_ISSUER": "https://YOUR_PROD_TENANT.auth0.com/",
        "OAUTH_AUDIENCE": "https://api.panote.io",
        // Days an old slug keeps redirecting after a rename (plan 3.2, Q6).
        "SLUG_ALIAS_DAYS": "30",
        // CDN purge target (B6). Placeholder zone id: the purge no-ops until it's real.
        "CDN_ZONE_ID": "YOUR_PANOTE_IO_ZONE_ID",
        "CDN_HOST": "cdn.panote.io",
      },
      // Daily sweep that releases expired slug aliases.
      "triggers": { "crons": ["17 3 * * *"] },
    },
  },
}
