{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys REQUIRE an environment: `wrangler deploy --env dev|production`.
  // Wrangler does NOT inherit vars/bindings into named environments, so every
  // binding is repeated under each env block. A bare `wrangler deploy` has none.
  // `main` exports no fetch handler - this Worker is a queue consumer
  // only, see src/consumer.ts.
  "name": "panote-tiler-consumer",
  "main": "src/consumer.ts",
  "compatibility_date": "2026-01-01",
  // Genuinely load-bearing here (unlike the other two Workers): @cloudflare/containers
  // depends on it.
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "dev": {
      "name": "panote-tiler-consumer-dev",
      // Queue consumer: needs no URL at all. Off like the other dev Workers.
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put R2_ACCESS_KEY_ID --env dev ; wrangler secret put R2_SECRET_ACCESS_KEY --env dev ; wrangler secret put ALERT_EMAIL_TO --env dev
      "durable_objects": {
        "bindings": [{ "name": "TILER", "class_name": "Tiler" }],
      },
      // Container classes are Durable Objects and must be registered via a
      // migration or `wrangler deploy` is rejected; container DOs require
      // SQLite-backed storage.
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tiler"] }],
      // Build context = repo root so the Dockerfile can vendor workspace
      // deps (@internal/tiler, @internal/contracts). Defaults to the
      // Dockerfile's own dir otherwise.
      "containers": [
        {
          "class_name": "Tiler",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          // standard-4 = 4 vCPU, 12 GiB, 20 GB disk: the largest predefined
          // type (a custom type tops out at the same 4 vCPU/12 GiB). The
          // libvips build was ~85% of a 227 s job on standard-1 (0.5 vCPU).
          // Memory: source spike showed 2.08 GiB peak at 134 MP single-
          // threaded; 12 GiB leaves room for 4 vips threads. CPU is billed on
          // active use, so a shorter job costs about the same. 5 x 4 vCPU =
          // 20 vCPU / 60 GiB, far under the account's concurrent limits.
          // VIPS_THREADS in src/container.ts must match the vCPU count.
          "instance_type": "standard-4",
          "max_instances": 5,
        },
      ],
      // BUCKET (unit B4): tile-failed marker read/write. Native binding, same
      // bucket the S3 client (container.ts) reaches via R2_ACCOUNT_ID/R2_BUCKET.
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content-dev" }],
      "queues": {
        "consumers": [
          {
            "queue": "pano-uploads-dev",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "pano-uploads-dlq-dev",
            // max_concurrency matches max_instances
            "max_concurrency": 5,
          },
          // unit B4: the same Worker also consumes its own DLQ, branching on
          // batch.queue - terminal, so no dead_letter_queue of its own.
          {
            "queue": "pano-uploads-dlq-dev",
            "max_batch_size": 10,
            "max_retries": 3,
            "max_concurrency": 1,
          },
        ],
      },
      "vars": {
        "MAX_ORIGINAL_BYTES": "157286400",
        "R2_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        "R2_BUCKET": "pano-content-dev",
        // Must be on an Email Routing domain; only panote.io has routing.
        "ALERT_EMAIL_FROM": "tiler-alerts@panote.io",
      },
      // DLQ alert email (src/alert.ts). Unrestricted on purpose: the recipient
      // is the ALERT_EMAIL_TO secret, so no address lives in the repo.
      "send_email": [{ "name": "ALERT_EMAIL" }],
    },
    "production": {
      // production is unprovisioned, see docs/deploy.md
      "name": "panote-tiler-consumer",
      "workers_dev": false,
      "observability": { "enabled": true },
      // secrets (per env): wrangler secret put R2_ACCESS_KEY_ID --env production ; wrangler secret put R2_SECRET_ACCESS_KEY --env production ; wrangler secret put ALERT_EMAIL_TO --env production
      "durable_objects": {
        "bindings": [{ "name": "TILER", "class_name": "Tiler" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tiler"] }],
      "containers": [
        {
          "class_name": "Tiler",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "standard-4",
          "max_instances": 5,
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content" }],
      "queues": {
        "consumers": [
          {
            "queue": "pano-uploads",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "pano-uploads-dlq",
            // max_concurrency matches max_instances
            "max_concurrency": 5,
          },
          {
            "queue": "pano-uploads-dlq",
            "max_batch_size": 10,
            "max_retries": 3,
            "max_concurrency": 1,
          },
        ],
      },
      "vars": {
        "MAX_ORIGINAL_BYTES": "157286400",
        "R2_ACCOUNT_ID": "12e2809e05de8a2bf20b815fd394ec9a",
        "R2_BUCKET": "pano-content",
        "ALERT_EMAIL_FROM": "tiler-alerts@panote.io",
      },
      "send_email": [{ "name": "ALERT_EMAIL" }],
    },
  },
}
