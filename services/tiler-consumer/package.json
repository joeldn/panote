{
  "name": "@service/tiler-consumer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Queue consumer that tiles uploaded panoramas via the Tiler container Durable Object",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -b tsconfig.container.json",
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --env dev",
    "types": "wrangler types env.d.ts --env dev --strict-vars=false --include-runtime=false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cloudflare/containers": "catalog:",
    "@internal/contracts": "workspace:*",
    "@internal/tiler": "workspace:*",
    "@internal/worker-kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@internal/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
