{
  "name": "@internal/tiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Node + sharp pipeline that remaps an equirectangular panorama into a 6-face cube tile pyramid, plus the pano-tile CLI",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pano-tile": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@panote/core": "workspace:*",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@internal/typescript-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
