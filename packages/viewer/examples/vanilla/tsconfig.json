{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Type-checks the example page (DOM) and its cube generator (Node, run with type stripping) without emitting either.",
  "extends": "@internal/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts"]
}
