{
  "name": "@panote/viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Progressive multiresolution cubemap panorama viewer: a hand-rolled WebGL2 renderer with no framework and no runtime dependencies",
  "license": "UNLICENSED",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-support",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p examples/vanilla/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "example": "vite examples/vanilla",
    "example:cube": "node examples/vanilla/make-cube.ts"
  },
  "devDependencies": {
    "@internal/typescript-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@panote/core": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
