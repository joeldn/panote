{
  "name": "@internal/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "panote design tokens, self-hosted fonts and icons, and React primitives",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./fonts.css": "./styles/fonts.css",
    "./icons.css": "./styles/icons.css"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/schibsted-grotesk": "catalog:",
    "@fontsource/spline-sans-mono": "catalog:",
    "@fortawesome/fontawesome-free": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/typescript-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
