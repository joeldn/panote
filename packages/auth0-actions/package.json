{
  "name": "@internal/auth0-actions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auth0 Actions kept as code: infra/pulumi deploys each src/*.cjs file to the tenant as it is (docs/deploy.md)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "echo \"@internal/auth0-actions: nothing to build (infra/pulumi deploys the files as they are)\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@internal/typescript-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
