{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Type-checks the Actions (plain CommonJS with JSDoc types, so the file in the repo is the file pasted into Auth0). Nothing is emitted.",
  "extends": "@internal/typescript-config/base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.cjs"]
}
