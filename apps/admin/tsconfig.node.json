{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Build tooling that runs on Node (vite/vitest/eslint configs), kept out of the browser config.",
  "extends": "@internal/typescript-config/base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["*.config.ts"]
}
