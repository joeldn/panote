# Build-time config for `vite build --mode dev` (panote.dev). Public: VITE_* is inlined
# into the bundle. Validated by loadConfig in @internal/web-kit.
VITE_SITE_ORIGIN=https://panote.dev
VITE_CDN_BASE=https://cdn.panote.dev/
VITE_AUTH0_DOMAIN=panote-dev.au.auth0.com
# The Auth0 dev SPA application (public client id; see docs/deploy.md).
VITE_AUTH0_CLIENT_ID=DEXWa49LnwVmX8flff1kcxHpj8G0d9d2
VITE_AUTH0_AUDIENCE=https://api.panote.dev
VITE_AUTH0_CONNECTIONS=google-oauth2
VITE_SHOWCASE_SLUG=
# CSP connect-src for presigned uploads (R2 S3 endpoint); build-only, not bundled.
CSP_UPLOAD_ORIGIN=https://12e2809e05de8a2bf20b815fd394ec9a.r2.cloudflarestorage.com
