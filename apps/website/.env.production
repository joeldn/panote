# Build-time config for `vite build --mode production` (panote.io). Public: VITE_* is
# inlined into the bundle. deploy.yml refuses to deploy while any YOUR_ value remains;
# replace each only with the real value, never another made-up tenant name.
VITE_SITE_ORIGIN=https://panote.io
VITE_CDN_BASE=https://cdn.panote.io/
VITE_AUTH0_DOMAIN=YOUR_PROD_TENANT.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_PROD_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://api.panote.io
VITE_AUTH0_CONNECTIONS=google-oauth2
VITE_SHOWCASE_SLUG=
