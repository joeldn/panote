{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets plus a small script that only runs for /s/*: slug alias 308s and tour
  // page priming (docs/deploy.md Frontends). Deploy with --env, after `vite build`.
  "name": "panote-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every other path is served straight from assets, never through the script.
    "run_worker_first": ["/s/*"],
  },
  "env": {
    "dev": {
      "name": "panote-website-dev",
      // workers.dev and Preview URLs are off: they would bypass the Access gate on
      // panote.dev (docs/deploy.md, Cloudflare Access).
      "workers_dev": false,
      "preview_urls": false,
      // The API Workers' /api/... routes and admin's /app routes are more specific,
      // so Cloudflare sends those paths there, not here (docs/deploy.md, Frontends).
      "routes": [{ "pattern": "panote.dev/*", "zone_name": "panote.dev" }],
      "observability": { "enabled": true },
      // Read-only by convention: the script only gets slugs/<slug>.json, pub/tours/<id>.json
      // and tiles/<pano>/manifest.json (docs/deploy.md, Tour page priming).
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content-dev" }],
      // Anything but "true" makes the /s/* script add X-Robots-Tag (docs/deploy.md).
      "vars": { "INDEXABLE": "false" },
    },
    "production": {
      // production is unprovisioned, see docs/deploy.md
      "name": "panote-website",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "panote.io/*", "zone_name": "panote.io" }],
      "observability": { "enabled": true },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pano-content" }],
      "vars": { "INDEXABLE": "true" },
    },
  },
}
